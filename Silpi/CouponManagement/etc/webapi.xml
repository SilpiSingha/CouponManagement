<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi/etc/webapi.xsd">

    <route url="/V1/coupon/create" method="POST">
        <service class="Silpi\CouponManagement\Api\CouponManagementInterface" method="createCoupon"/>
        <resources>
			<resource ref="anonymous"/>
        </resources>
    </route>

    <route url="/V1/coupon/list" method="GET">
        <service class="Silpi\CouponManagement\Api\CouponListInterface" method="getList"/>
        <resources>
			<resource ref="anonymous"/>
        </resources>
    </route>

    <route url="/V1/coupon/:id" method="GET">
        <service class="Silpi\CouponManagement\Api\CouponGetInterface" method="getById"/>
        <resources>
			<resource ref="anonymous"/>
        </resources>
    </route>

    <route url="/V1/apply-coupon/:id" method="POST">
        <service class="Silpi\CouponManagement\Api\ApplyCouponInterface" method="applyCoupon"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <route url="/V1/applicable-coupons" method="POST">
        <service class="Silpi\CouponManagement\Api\ApplicableCouponsInterface" method="getApplicableCoupons"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <route url="/V1/coupons/:id" method="PUT">
        <service class="Silpi\CouponManagement\Api\CouponManagementInterface" method="updateCoupon"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <route url="/V1/coupons/:id" method="DELETE">
        <service class="Silpi\CouponManagement\Api\CouponManagementInterface" method="deleteCoupon"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>

