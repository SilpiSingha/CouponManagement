<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="discount_rules" resource="default" comment="Payout Information Table">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="type" length="32" nullable="true" comment="Coupon Type"/>
        <column xsi:type="varchar" name="code" length="32" nullable="false" comment="Coupon Code"/>
        <column xsi:type="text" name="condition_details" nullable="true" comment="Coupon Condition"/>
        <column xsi:type="text" name="discount_details" nullable="true" comment="Coupon Discount Details"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
</schema>